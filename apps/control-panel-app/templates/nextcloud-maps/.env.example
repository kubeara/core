SERVICE_PORT_NEXTCLOUD_MAPS=8989

# Geofabrik PBF used on first start (Andorra is small for demo/e2e).
# Change to your region, e.g. https://download.geofabrik.de/europe/germany-latest.osm.pbf
NEXTCLOUD_MAPS_PBF_URL=https://download.geofabrik.de/europe/andorra-latest.osm.pbf

# Increase heap for larger extracts (match deploy memory limits).
NEXTCLOUD_MAPS_JAVA_OPTS=-Xmx1g -Xms1g

NEXTCLOUD_MAPS_IMAGE=israelhikingmap/graphhopper:latest
NEXTCLOUD_MAPS_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL when running behind a reverse proxy.
# In Nextcloud → Administration → Additional settings → Maps, set GraphHopper URL to SERVICE_URL_NEXTCLOUD_MAPS
SERVICE_URL_NEXTCLOUD_MAPS_8989=http://localhost:8989
SERVICE_URL_NEXTCLOUD_MAPS=http://localhost:8989
SERVICE_FQDN_NEXTCLOUD_MAPS_8989=localhost
SERVICE_FQDN_NEXTCLOUD_MAPS=localhost
