SERVICE_PORT_METAMCP=12008
SERVICE_USER_POSTGRES=metamcp
SERVICE_PASSWORD_POSTGRES=metamcp_password
SERVICE_PASSWORD_AUTH=metamcp_auth_secret
METAMCP_IMAGE=ghcr.io/metatool-ai/metamcp:2.4
METAMCP_RESTART_POLICY=unless-stopped
METAMCP_POSTGRES_IMAGE=postgres:16-alpine
METAMCP_POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=metamcp_db
TRANSFORM_LOCALHOST_TO_DOCKER_INTERNAL=true
TZ=UTC

SERVICE_URL_METAMCP_12008=http://localhost:12008
SERVICE_URL_METAMCP=http://localhost:12008
SERVICE_FQDN_METAMCP_12008=localhost
SERVICE_FQDN_METAMCP=localhost
