SERVICE_PORT_NEXTCLOUD_SPREED=8081
SERVICE_PORT_NEXTCLOUD_SPREED_3478=3478

# Hostname of your existing Nextcloud instance (no scheme).
NEXTCLOUD_SPREED_NC_DOMAIN=cloud.example.com

# Optional TURN hostname override (defaults to SERVICE_FQDN_NEXTCLOUD_SPREED).
# NEXTCLOUD_SPREED_TURN_DOMAIN=talk.example.com

# Auto-generated hex secrets (or set explicitly for local/e2e).
SERVICE_HEX_64_SPREEDTURN=1111111111111111111111111111111111111111111111111111111111111111
SERVICE_HEX_64_SPREEDSIG=2222222222222222222222222222222222222222222222222222222222222222
SERVICE_HEX_64_SPREEDINT=3333333333333333333333333333333333333333333333333333333333333333

# Public URL when running behind a reverse proxy (signaling HTTP/WebSocket).
SERVICE_URL_NEXTCLOUD_SPREED_8081=http://localhost:8081
SERVICE_URL_NEXTCLOUD_SPREED=http://localhost:8081
SERVICE_FQDN_NEXTCLOUD_SPREED_8081=localhost
SERVICE_FQDN_NEXTCLOUD_SPREED=localhost

NEXTCLOUD_SPREED_TALK_PORT=3478
NEXTCLOUD_SPREED_SKIP_CERT_VERIFY=false
NEXTCLOUD_SPREED_MAX_STREAM_BITRATE=1048576
NEXTCLOUD_SPREED_MAX_SCREEN_BITRATE=2097152
NEXTCLOUD_SPREED_IMAGE=ghcr.io/nextcloud-releases/aio-talk:latest
NEXTCLOUD_SPREED_RESTART_POLICY=unless-stopped
TZ=UTC
