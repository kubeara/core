SERVICE_PORT_LANGFUSE=3000
SERVICE_USER_LANGFUSE=langfuse
SERVICE_PASSWORD_LANGFUSE=langfuse_password
SERVICE_PASSWORD_LANGFUSE_CLICKHOUSE=langfuse_clickhouse_password
SERVICE_PASSWORD_LANGFUSE_REDIS=langfuse_redis_password
SERVICE_USER_LANGFUSE_MINIO=langfuse_minio
SERVICE_PASSWORD_LANGFUSE_MINIO=langfuse_minio_password
LANGFUSE_DB_NAME=langfuse
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_WEB_IMAGE=langfuse/langfuse:3
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3
LANGFUSE_RESTART_POLICY=unless-stopped
LANGFUSE_POSTGRES_IMAGE=postgres:16
LANGFUSE_POSTGRES_RESTART_POLICY=unless-stopped
LANGFUSE_POSTGRES_DATA_PATH=/var/lib/postgresql/data
LANGFUSE_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
LANGFUSE_CLICKHOUSE_RESTART_POLICY=unless-stopped
LANGFUSE_REDIS_IMAGE=redis:7.4-alpine
LANGFUSE_REDIS_RESTART_POLICY=unless-stopped
LANGFUSE_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
LANGFUSE_MINIO_RESTART_POLICY=unless-stopped
TZ=UTC
PGTZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_LANGFUSE_3000=http://localhost:3000
SERVICE_URL_LANGFUSE=http://localhost:3000
SERVICE_FQDN_LANGFUSE_3000=localhost
SERVICE_FQDN_LANGFUSE=localhost
