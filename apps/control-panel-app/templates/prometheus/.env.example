SERVICE_PORT_PROMETHEUS=9090
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
PROMETHEUS_RESTART_POLICY=unless-stopped
PROMETHEUS_RETENTION_TIME=15d

# Public URL when running behind a reverse proxy.
SERVICE_URL_PROMETHEUS_9090=http://localhost:9090
SERVICE_URL_PROMETHEUS=http://localhost:9090
SERVICE_FQDN_PROMETHEUS_9090=localhost
SERVICE_FQDN_PROMETHEUS=localhost
