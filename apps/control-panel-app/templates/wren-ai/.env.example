SERVICE_PORT_WREN_AI=3000

# Required for LLM calls (LiteLLM reads this in wren-ai-service).
OPENAI_API_KEY=sk-replace_me_with_your_openai_api_key

GENERATION_MODEL=gpt-4o-mini

# Service versions (keep in sync with docker-compose defaults).
WREN_PRODUCT_VERSION=0.29.2
WREN_ENGINE_VERSION=0.22.0
WREN_AI_SERVICE_VERSION=0.29.3
WREN_UI_VERSION=0.32.3
WREN_BOOTSTRAP_VERSION=0.1.5
IBIS_SERVER_VERSION=0.22.0
QDRANT_IMAGE=qdrant/qdrant:v1.15.0

# Stable UUID for UI/telemetry identity in self-hosted deploys.
USER_UUID=00000000-0000-4000-8000-000000000001

TELEMETRY_ENABLED=false
POSTHOG_API_KEY=phc_nhF32aj4xHXOZb0oqr2cn4Oy9uiWzz6CCP4KZmRq9aE
POSTHOG_HOST=https://app.posthog.com
EXPERIMENTAL_ENGINE_RUST_VERSION=false
SHOULD_FORCE_DEPLOY=1

# Optional observability (uncomment to enable).
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=

TZ=UTC

SERVICE_URL_WREN_AI_3000=http://localhost:3000
SERVICE_URL_WREN_AI=http://localhost:3000
