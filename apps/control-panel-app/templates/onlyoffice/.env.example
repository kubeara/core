SERVICE_PORT_ONLYOFFICE=80
SERVICE_PASSWORD_ONLYOFFICE=onlyoffice_jwt_secret
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.2
ONLYOFFICE_RESTART_POLICY=unless-stopped

# Public URL used by ONLYOFFICE behind a reverse proxy.
SERVICE_URL_ONLYOFFICE_80=http://localhost:80
SERVICE_URL_ONLYOFFICE=http://localhost:80
SERVICE_FQDN_ONLYOFFICE_80=localhost
SERVICE_FQDN_ONLYOFFICE=localhost

JWT_ENABLED=true
JWT_HEADER=Authorization
JWT_IN_BODY=false
ALLOW_PRIVATE_IP_ADDRESS=true
TZ=UTC
