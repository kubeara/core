SERVICE_PORT_UPTIME_KUMA=3001
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2
UPTIME_KUMA_RESTART_POLICY=unless-stopped

# Public URL when running behind a reverse proxy.
SERVICE_URL_UPTIME_KUMA_3001=http://localhost:3001
SERVICE_URL_UPTIME_KUMA=http://localhost:3001
SERVICE_FQDN_UPTIME_KUMA_3001=localhost
SERVICE_FQDN_UPTIME_KUMA=localhost
