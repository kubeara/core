SERVICE_PORT_KUBEARA=9461
SERVICE_PORT_KUBEARA_CONSOLE=7935

# Auto-generated per deployment when unset.
SERVICE_USER_KUBEARA=kubeara
SERVICE_PASSWORD_KUBEARA=kubeara_password
SERVICE_PASSWORD_64_ENCRYPTION=change-me-32-plus-char-secret-value
SERVICE_PASSWORD_64_JWT=change-me-64-char-jwt-signing-secret-value-aaaaaaaaaaaaaaaaaaaa
SERVICE_PASSWORD_64_JWTREFRESH=change-me-64-char-refresh-signing-secret-value-bbbbbbbbbbbbbbbbbbbb

KUBEARA_DB_NAME=kubeara
KUBEARA_CONTROL_PANEL_IMAGE=kubeara/control-panel:prod
KUBEARA_CONSOLE_IMAGE=kubeara/console:prod
KUBEARA_POSTGRES_IMAGE=postgres:16-alpine
KUBEARA_AGENT_IMAGE=kubeara/agent:prod
DOCKER_PLATFORM=linux/amd64

KUBEARA_RESTART_POLICY=unless-stopped
KUBEARA_CONSOLE_RESTART_POLICY=unless-stopped
KUBEARA_MIGRATE_RESTART_POLICY=no
KUBEARA_POSTGRES_RESTART_POLICY=unless-stopped

TZ=UTC

# Base address used when installing agents on OTHER servers (agents call
# back to this address). Leave unset for same-host deployments: the panel
# then derives http://localhost:<SERVICE_PORT_KUBEARA> automatically, so
# changing the backend port stays consistent. Override only when agents on
# remote machines must reach a public address, e.g. http://<panel-ip>:9461
# or https://panel.example.com
#CONTROL_PANEL_URL=

# API base URL used by the web console. "/" (default) means the console
# calls the backend directly on its exposed port, built from the browser
# hostname plus SERVICE_PORT_KUBEARA — e.g. http://<host>:9461/api.
# Set an absolute URL only when the API lives on another host/domain
# (cloud setups); such origins must be allowed via CORS_ALLOWED_ORIGINS.
VITE_API_URL=/

# Extra explicitly allowed browser origins (comma separated). The console's
# own origin is already allowed automatically via SERVICE_PORT_KUBEARA_CONSOLE.
#CORS_ALLOWED_ORIGINS=http://localhost