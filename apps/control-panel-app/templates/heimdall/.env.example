SERVICE_PORT_HEIMDALL=8081
HEIMDALL_IMAGE=lscr.io/linuxserver/heimdall:latest
HEIMDALL_RESTART_POLICY=unless-stopped
HEIMDALL_PUID=1000
HEIMDALL_PGID=1000
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_HEIMDALL_80=http://localhost:8081
SERVICE_URL_HEIMDALL=http://localhost:8081
SERVICE_FQDN_HEIMDALL_80=localhost
SERVICE_FQDN_HEIMDALL=localhost
