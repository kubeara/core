SERVICE_PASSWORD_STRAPI=strapi_password
STRAPI_DB_NAME=strapi
STRAPI_DB_HOST=postgres
STRAPI_DB_PORT=5432
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=apiTokenSalt
STRAPI_ADMIN_JWT_SECRET=adminJwtSecret
STRAPI_TRANSFER_TOKEN_SALT=transferTokenSalt
STRAPI_JWT_SECRET=jwtSecret
STRAPI_IMAGE=naskio/strapi:5.30.1-alpine
NODE_ENV=production
STRAPI_RESTART_POLICY=unless-stopped
STRAPI_POSTGRES_IMAGE=postgres:16
STRAPI_POSTGRES_RESTART_POLICY=unless-stopped
STRAPI_POSTGRES_DATA_PATH=/var/lib/postgresql/data
TZ=UTC
PGTZ=UTC

