SERVICE_PORT_GRAFANA=3000
SERVICE_USER_GRAFANA=admin
SERVICE_PASSWORD_GRAFANA=grafana_admin_password
GRAFANA_IMAGE=grafana/grafana:11.4.0
GRAFANA_RESTART_POLICY=unless-stopped

# Public URL used by Grafana UI behind a reverse proxy.
SERVICE_URL_GRAFANA_3000=http://localhost:3000
SERVICE_URL_GRAFANA=http://localhost:3000
SERVICE_FQDN_GRAFANA_3000=localhost
SERVICE_FQDN_GRAFANA=localhost

GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
