SERVICE_PORT_NEXTCLOUD_AIO=8080

# Reverse-proxy mode (recommended): Apache listens on the host at this port.
# Point your reverse proxy at http://<host>:11000 after AIO setup.
NEXTCLOUD_AIO_APACHE_PORT=11000
NEXTCLOUD_AIO_APACHE_IP_BINDING=0.0.0.0

# Set true only when domain validation cannot reach this host (e.g. local/e2e).
NEXTCLOUD_AIO_SKIP_DOMAIN_VALIDATION=false

NEXTCLOUD_AIO_TALK_PORT=3478
NEXTCLOUD_AIO_DISABLE_BACKUP_SECTION=false
NEXTCLOUD_AIO_LOG_LEVEL=warn
NEXTCLOUD_AIO_UPLOAD_LIMIT=16G
NEXTCLOUD_AIO_MAX_TIME=3600
NEXTCLOUD_AIO_MEMORY_LIMIT=512M
NEXTCLOUD_AIO_COLLABORA_SECCOMP_DISABLED=false
NEXTCLOUD_AIO_DOCKER_SOCKET_PATH=/var/run/docker.sock
NEXTCLOUD_AIO_IMAGE=ghcr.io/nextcloud-releases/all-in-one:latest
NEXTCLOUD_AIO_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL for the AIO setup interface (HTTPS with self-signed cert on 8080).
SERVICE_URL_NEXTCLOUD_AIO_8080=https://localhost:8080
SERVICE_URL_NEXTCLOUD_AIO=https://localhost:8080
SERVICE_FQDN_NEXTCLOUD_AIO_8080=localhost
SERVICE_FQDN_NEXTCLOUD_AIO=localhost
