SERVICE_PORT_NEXTCLOUD=80
SERVICE_USER_NEXTCLOUD=nextcloud
SERVICE_PASSWORD_NEXTCLOUD=nextcloud_password
SERVICE_PASSWORD_NEXTCLOUD_ADMIN=nextcloud_admin_password
SERVICE_PASSWORD_MARIADB_ROOT=mariadb_root_password
SERVICE_PASSWORD_REDIS=redis_password
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_HOST=mariadb
NEXTCLOUD_REDIS_HOST=redis
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_TRUSTED_DOMAINS=localhost
NEXTCLOUD_OVERWRITE_PROTOCOL=http
NEXTCLOUD_IMAGE=nextcloud:latest
NEXTCLOUD_RESTART_POLICY=unless-stopped
NEXTCLOUD_MARIADB_IMAGE=mariadb:11.4
NEXTCLOUD_MARIADB_RESTART_POLICY=unless-stopped
NEXTCLOUD_REDIS_IMAGE=redis:7.4-alpine
NEXTCLOUD_REDIS_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_NEXTCLOUD_80=http://localhost
SERVICE_URL_NEXTCLOUD=http://localhost
SERVICE_FQDN_NEXTCLOUD_80=localhost
SERVICE_FQDN_NEXTCLOUD=localhost
