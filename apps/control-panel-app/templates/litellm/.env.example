SERVICE_PORT_LITELLM=4000
SERVICE_USER_LITELLM=litellm
SERVICE_PASSWORD_LITELLM=litellm_password
LITELLM_DB_NAME=litellm
LITELLM_STORE_MODEL_IN_DB=true
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_RESTART_POLICY=unless-stopped
LITELLM_POSTGRES_IMAGE=postgres:16
LITELLM_POSTGRES_RESTART_POLICY=unless-stopped
LITELLM_POSTGRES_DATA_PATH=/var/lib/postgresql/data
TZ=UTC
PGTZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_LITELLM_4000=http://localhost:4000
SERVICE_URL_LITELLM=http://localhost:4000
SERVICE_FQDN_LITELLM_4000=localhost
SERVICE_FQDN_LITELLM=localhost
