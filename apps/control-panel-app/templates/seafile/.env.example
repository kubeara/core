SERVICE_PORT_SEAFILE=80
SERVICE_USER_SEAFILE=seafile
SERVICE_PASSWORD_SEAFILE=seafile_password
SERVICE_PASSWORD_SEAFILE_ADMIN=seafile_admin_password
SERVICE_PASSWORD_MARIADB_ROOT=mariadb_root_password
SERVICE_PASSWORD_REDIS=redis_password
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_SERVER_HOSTNAME=localhost
SEAFILE_SERVER_PROTOCOL=http
SEAFILE_DB_HOST=mariadb
SEAFILE_DB_PORT=3306
SEAFILE_CCNET_DB_NAME=ccnet_db
SEAFILE_SEAFILE_DB_NAME=seafile_db
SEAFILE_SEAHUB_DB_NAME=seahub_db
SEAFILE_CACHE_PROVIDER=redis
SEAFILE_REDIS_HOST=redis
SEAFILE_REDIS_PORT=6379
SEAFILE_ENABLE_GO_FILESERVER=true
SEAFILE_LOG_TO_STDOUT=false
SEAFILE_MARIADB_AUTO_UPGRADE=1
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0-latest
SEAFILE_RESTART_POLICY=unless-stopped
SEAFILE_MARIADB_IMAGE=mariadb:11.4
SEAFILE_MARIADB_RESTART_POLICY=unless-stopped
SEAFILE_REDIS_IMAGE=redis:7.4-alpine
SEAFILE_REDIS_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_SEAFILE_80=http://localhost
SERVICE_URL_SEAFILE=http://localhost
SERVICE_FQDN_SEAFILE_80=localhost
SERVICE_FQDN_SEAFILE=localhost
