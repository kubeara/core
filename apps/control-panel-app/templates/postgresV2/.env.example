# Local reference only — deploy API persists resolved values to environment_variables.
# Copy to .env for manual docker compose testing if needed.

POSTGRES_IMAGE=postgres:16
SERVICE_PORT_POSTGRESV2=5433
POSTGRES_DB=app_dev
SERVICE_USER_POSTGRESV2=postgres
SERVICE_PASSWORD_POSTGRESV2=changeme
POSTGRES_DATA_PATH=/var/lib/postgresql/data
TZ=UTC
PGTZ=UTC
