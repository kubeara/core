SERVICE_PORT_ORGANIZR=8082
ORGANIZR_IMAGE=organizr/organizr:latest
ORGANIZR_RESTART_POLICY=unless-stopped
ORGANIZR_PUID=1000
ORGANIZR_PGID=1000
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_ORGANIZR_80=http://localhost:8082
SERVICE_URL_ORGANIZR=http://localhost:8082
SERVICE_FQDN_ORGANIZR_80=localhost
SERVICE_FQDN_ORGANIZR=localhost
