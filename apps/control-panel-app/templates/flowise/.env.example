SERVICE_PORT_FLOWISE=3000
FLOWISE_IMAGE=flowiseai/flowise:latest
FLOWISE_RESTART_POLICY=unless-stopped
FLOWISE_TRUST_PROXY=true
FLOWISE_DISABLE_TELEMETRY=true
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_FLOWISE_3000=http://localhost:3000
SERVICE_URL_FLOWISE=http://localhost:3000
SERVICE_FQDN_FLOWISE_3000=localhost
SERVICE_FQDN_FLOWISE=localhost
