SERVICE_PORT_WAKAPI=3000
SERVICE_USER_WAKAPI=admin
SERVICE_PASSWORD_WAKAPI=wakapi_admin_password
WAKAPI_IMAGE=ghcr.io/muety/wakapi:latest
WAKAPI_RESTART_POLICY=unless-stopped
WAKAPI_DB_TYPE=sqlite3
WAKAPI_DB_NAME=wakapi.db
WAKAPI_CREATE_ADMIN=true
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_WAKAPI_3000=http://localhost:3000
SERVICE_URL_WAKAPI=http://localhost:3000
SERVICE_FQDN_WAKAPI_3000=localhost
SERVICE_FQDN_WAKAPI=localhost
