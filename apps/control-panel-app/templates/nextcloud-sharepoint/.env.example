SERVICE_PORT_NEXTCLOUD_SHAREPOINT=8080

# SharePoint Online document library WebDAV URL, e.g.
# https://contoso-my.sharepoint.com/personal/user_contoso_com/Documents
# Leave empty to serve a local placeholder directory (useful for e2e/smoke tests).
NEXTCLOUD_SHAREPOINT_SITE_URL=

# sharepoint = SharePoint Online (Microsoft account)
# sharepoint-ntlm = on-prem SharePoint with NTLM
NEXTCLOUD_SHAREPOINT_VENDOR=sharepoint

SERVICE_USER_SHAREPOINT=user@example.com
SERVICE_PASSWORD_SHAREPOINT=change_me_sharepoint_app_password

NEXTCLOUD_SHAREPOINT_IMAGE=rclone/rclone:latest
NEXTCLOUD_SHAREPOINT_RESTART_POLICY=unless-stopped
TZ=UTC

# Public WebDAV URL for Nextcloud External Storage (WebDAV backend).
SERVICE_URL_NEXTCLOUD_SHAREPOINT_8080=http://localhost:8080
SERVICE_URL_NEXTCLOUD_SHAREPOINT=http://localhost:8080
SERVICE_FQDN_NEXTCLOUD_SHAREPOINT_8080=localhost
SERVICE_FQDN_NEXTCLOUD_SHAREPOINT=localhost
