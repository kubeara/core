FORMBRICKS_CUBE_IMAGE=cubejs/cube:v1.6.6
FORMBRICKS_REDIS_IMAGE=redis:7-alpine
FORMBRICKS_POSTGRES_IMAGE=pgvector/pgvector:pg16
FORMBRICKS_RESTART_POLICY=unless-stopped
FORMBRICKS_MIGRATE_RESTART_POLICY=no
FORMBRICKS_HUB_RESTART_POLICY=unless-stopped
FORMBRICKS_HUB_MIGRATE_RESTART_POLICY=no
FORMBRICKS_CUBE_RESTART_POLICY=unless-stopped
FORMBRICKS_REDIS_RESTART_POLICY=unless-stopped
FORMBRICKS_POSTGRES_RESTART_POLICY=unless-stopped
FORMBRICKS_HUB_API_URL=http://hub:8080
FORMBRICKS_CUBEJS_API_URL=http://cube:4000
FORMBRICKS_CUBEJS_JWT_ISSUER=formbricks-web
