SERVICE_PORT_WORDPRESS=80
SERVICE_USER_WORDPRESS=wordpress
SERVICE_PASSWORD_WORDPRESS=wordpress_password
SERVICE_PASSWORD_MARIADB_ROOT=mariadb_root_password
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_HOST=mariadb
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_IMAGE=wordpress:latest
WORDPRESS_RESTART_POLICY=unless-stopped
WORDPRESS_MARIADB_IMAGE=mariadb:latest
WORDPRESS_MARIADB_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_WORDPRESS_80=http://localhost
SERVICE_URL_WORDPRESS=http://localhost
SERVICE_FQDN_WORDPRESS_80=localhost
SERVICE_FQDN_WORDPRESS=localhost
