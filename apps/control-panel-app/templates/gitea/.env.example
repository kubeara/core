SERVICE_PORT_GITEA=3000
GITEA_IMAGE=gitea/gitea:1.26.2
GITEA_RESTART_POLICY=unless-stopped

# Public URL used by Gitea behind a reverse proxy.
SERVICE_URL_GITEA_3000=http://localhost:3000/
SERVICE_URL_GITEA=http://localhost:3000/
SERVICE_FQDN_GITEA_3000=localhost
SERVICE_FQDN_GITEA=localhost

GITEA_DISABLE_SSH=true
