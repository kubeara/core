SERVICE_PORT_RADICALE=5232
SERVICE_USER_RADICALE=radicale
SERVICE_PASSWORD_RADICALE=change_me_radicale_password

# Public URL when running behind a reverse proxy.
SERVICE_URL_RADICALE_5232=http://localhost:5232
SERVICE_URL_RADICALE=http://localhost:5232
SERVICE_FQDN_RADICALE_5232=localhost
SERVICE_FQDN_RADICALE=localhost

RADICALE_AUTH_TYPE=htpasswd
RADICALE_TAKE_FILE_OWNERSHIP=true
RADICALE_IMAGE=tomsquest/docker-radicale:latest
RADICALE_RESTART_POLICY=unless-stopped
TZ=UTC
