SERVICE_PORT_GRAFANA_WITH_POSTGRESQL=3000
SERVICE_USER_GRAFANA_WITH_POSTGRESQL=grafana
SERVICE_PASSWORD_GRAFANA_WITH_POSTGRESQL=grafana_postgres_password
GRAFANA_WITH_POSTGRESQL_DB_NAME=grafana
GRAFANA_WITH_POSTGRESQL_IMAGE=grafana/grafana:13.0.2
GRAFANA_WITH_POSTGRESQL_POSTGRES_IMAGE=postgres:16-alpine
GRAFANA_WITH_POSTGRESQL_RESTART_POLICY=unless-stopped
GRAFANA_WITH_POSTGRESQL_POSTGRES_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL used by Grafana UI behind a reverse proxy.
SERVICE_URL_GRAFANA_WITH_POSTGRESQL_3000=http://localhost:3000
SERVICE_URL_GRAFANA_WITH_POSTGRESQL=http://localhost:3000
SERVICE_FQDN_GRAFANA_WITH_POSTGRESQL_3000=localhost
SERVICE_FQDN_GRAFANA_WITH_POSTGRESQL=localhost
