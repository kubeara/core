SERVICE_PORT_VIKUNJA=3456
SERVICE_USER_VIKUNJA=vikunja
SERVICE_PASSWORD_VIKUNJA=change_me_vikunja_db_password
SERVICE_PASSWORD_64_VIKUNJA=change_me_vikunja_service_secret_must_be_long_enough_64chars_xx

VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_HOST=postgres
VIKUNJA_ENABLE_REGISTRATION=true
VIKUNJA_IMAGE=vikunja/vikunja:2.5.0
VIKUNJA_RESTART_POLICY=unless-stopped
VIKUNJA_POSTGRES_IMAGE=postgres:16-alpine
VIKUNJA_POSTGRES_RESTART_POLICY=unless-stopped
TZ=UTC

# Public URL when running behind a reverse proxy (include trailing slash per Vikunja docs).
SERVICE_URL_VIKUNJA_3456=http://localhost:3456/
SERVICE_URL_VIKUNJA=http://localhost:3456/
SERVICE_FQDN_VIKUNJA_3456=localhost
SERVICE_FQDN_VIKUNJA=localhost
