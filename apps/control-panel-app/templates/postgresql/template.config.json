{
  "env_schema": {
    "POSTGRES_USER": {
      "type": "string",
      "required": true,
      "description": "Database username"
    },
    "POSTGRES_PASSWORD": {
      "type": "string",
      "required": true,
      "description": "Database password"
    },
    "POSTGRES_DB": {
      "type": "string",
      "required": true,
      "description": "Database name"
    },
    "POSTGRES_IMAGE": {
      "type": "string",
      "required": false,
      "default": "postgres:16",
      "description": "Docker image"
    },
    "POSTGRES_RESTART_POLICY": {
      "type": "string",
      "required": false,
      "default": "always"
    },
    "POSTGRES_DATA_PATH": {
      "type": "string",
      "required": false,
      "default": "/var/lib/postgresql/data"
    },
    "TZ": {
      "type": "string",
      "required": false,
      "default": "UTC"
    },
    "PGTZ": {
      "type": "string",
      "required": false,
      "default": "UTC"
    }
  },
  "port_schema": {
    "POSTGRES_PORT": {
      "type": "number",
      "required": true,
      "description": "Host port"
    }
  }
}
