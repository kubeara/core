SERVICE_PORT_NEXTCLOUD_OFFICE=9980

# Hostname of your existing Nextcloud instance (no scheme).
NEXTCLOUD_OFFICE_NC_DOMAIN=cloud.example.com

# Collabora admin console credentials.
SERVICE_USER_COLABORA=admin
SERVICE_PASSWORD_COLABORA=change_me_collabora_password

# Public URL when running behind a reverse proxy (WebSocket-capable).
SERVICE_URL_NEXTCLOUD_OFFICE_9980=http://localhost:9980
SERVICE_URL_NEXTCLOUD_OFFICE=http://localhost:9980
SERVICE_FQDN_NEXTCLOUD_OFFICE_9980=localhost
SERVICE_FQDN_NEXTCLOUD_OFFICE=localhost

NEXTCLOUD_OFFICE_DICTIONARIES=en_US
NEXTCLOUD_OFFICE_DONT_GEN_SSL_CERT=1
NEXTCLOUD_OFFICE_LOG_LEVEL=warning
NEXTCLOUD_OFFICE_SHM_SIZE=256mb
NEXTCLOUD_OFFICE_IMAGE=collabora/code:latest
NEXTCLOUD_OFFICE_RESTART_POLICY=unless-stopped
TZ=UTC
