SERVICE_PORT_ANYTHING_LLM=3001
ANYTHING_LLM_IMAGE=mintplexlabs/anythingllm:latest
ANYTHING_LLM_RESTART_POLICY=unless-stopped
ANYTHING_LLM_DISABLE_TELEMETRY=true
TZ=UTC

# Public URL when running behind a reverse proxy.
SERVICE_URL_ANYTHING_LLM_3001=http://localhost:3001
SERVICE_URL_ANYTHING_LLM=http://localhost:3001
SERVICE_FQDN_ANYTHING_LLM_3001=localhost
SERVICE_FQDN_ANYTHING_LLM=localhost
