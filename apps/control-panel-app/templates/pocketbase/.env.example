SERVICE_PORT_POCKETBASE=8090
POCKETBASE_IMAGE=ghcr.io/muchobien/pocketbase:latest
POCKETBASE_RESTART_POLICY=unless-stopped

# Public URL when running behind a reverse proxy.
SERVICE_URL_POCKETBASE_8090=http://localhost:8090
SERVICE_URL_POCKETBASE=http://localhost:8090
SERVICE_FQDN_POCKETBASE_8090=localhost
SERVICE_FQDN_POCKETBASE=localhost
