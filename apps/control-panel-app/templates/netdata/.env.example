SERVICE_PORT_NETDATA=19999
NETDATA_LISTENER_PORT=19999
NETDATA_HOSTNAME=netdata
NETDATA_IMAGE=netdata/netdata:stable
NETDATA_RESTART_POLICY=unless-stopped
NETDATA_DISABLE_TELEMETRY=1
TZ=UTC

# Optional: add to deployment env to connect this node to Netdata Cloud.
# NETDATA_CLAIM_TOKEN=your_claim_token
# NETDATA_CLAIM_URL=https://app.netdata.cloud
# NETDATA_CLAIM_ROOMS=room_uuid

# Public URL when running behind a reverse proxy.
SERVICE_URL_NETDATA_19999=http://localhost:19999
SERVICE_URL_NETDATA=http://localhost:19999
SERVICE_FQDN_NETDATA_19999=localhost
SERVICE_FQDN_NETDATA=localhost
