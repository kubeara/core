# Copy to .env.control-panel, then:
#   docker compose -f docker-compose.control-panel.yml --env-file .env.control-panel up -d
#
# ENCRYPTION_SECRET: use the same value on the agent (.env.agent).

# Compose Postgres has no TLS. Keep development so Hub images connect without SSL.
NODE_ENV=development

KUBEARA_CONTROL_PANEL_IMAGE=kubeara/control-panel:prod
KUBEARA_CONSOLE_IMAGE=kubeara/console:prod
# linux/amd64 on Apple Silicon until multi-arch images are pulled; use linux/arm64 when available
DOCKER_PLATFORM=linux/amd64

PORT=3000
CONSOLE_PORT=8080
# Console runtime API origin — URL the **browser** uses to call the API (must be
# reachable from the user's machine, not from inside Docker).
# Browser API origin (must be reachable from the user's machine).
# Local:  http://localhost:3000/api
# Remote: http://PUBLIC_IP:3000/api  or  https://panel.example.com/api
# install.sh auto-fills a public default-route IP when present; override with VITE_API_URL=...
VITE_API_URL=http://localhost:3000/api
ENCRYPTION_SECRET=change-me-to-a-long-random-secret

# Auth (required). install.sh auto-generates secrets if missing.
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret

# HTTP-only cookie authentication.
# COOKIE_DOMAIN: leave empty for self-host (local or remote IP / single host).
#   Only set for multi-subdomain HTTPS cloud (e.g. .kubeara.dev) with COOKIE_SECURE=true.
ACCESS_TOKEN_COOKIE_NAME=kubeara_access_token
REFRESH_TOKEN_COOKIE_NAME=kubeara_refresh_token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

OTP_EXPIRES_IN=2m

# Browser origins for public marketing APIs (/api/public/*)
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Optional: broader list for console/auth (defaults to PUBLIC_API_ALLOWED_ORIGINS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
# true = public/cloud panel: agents connect via CONTROL_PANEL_URL (no SSH tunnels).
# false or omit = self-host: panel opens an SSH reverse tunnel; remote agents use host.docker.internal:<AGENT_SOCKET_TUNNEL_PORT>.
IS_CLOUD_VERSION=false
# Required for self-host remote agents (SSH reverse-tunnel listen port on the VPS).
AGENT_SOCKET_TUNNEL_PORT=1111

# Public URL remote agents use in cloud mode (and local-agent installs). Not required for remote self-host tunnels.
CONTROL_PANEL_URL=http://localhost:3000

# Optional email — empty keys keep older Hub images (getOrThrow BREVO_*) from crashing
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Kubeara

# Stripe / Zoho optional — leave as placeholders or unset; integrations soft-disable
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CHECKOUT_PAYMENT_METHODS=card
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORGANIZATION_ID=
# ZOHO_DEPARTMENT_ID=
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
# ZOHO_DESK_BASE_URL=https://desk.zoho.in/api/v1

# Values below are used inside containers (DB_HOST must be the compose service name).
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kubeara
DB_SSL=false

# Grafana Cloud Loki (optional — see deploy/.env.monitoring.example)
# GRAFANA_CLOUD_LOKI_URL=
# GRAFANA_CLOUD_LOKI_USER=
# GRAFANA_CLOUD_LOKI_API_KEY=
# KUBEARA_ENV=PROD
# KUBEARA_HOST_LABEL=control-panel-1
# LOG_LEVEL=info
