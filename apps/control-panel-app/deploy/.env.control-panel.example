# Copy to .env.control-panel, then:
#   docker compose --env-file .env.control-panel up -d

KUBEARA_CONTROL_PANEL_IMAGE=your-dockerhub-username/control-panel-app:latest

PORT=3000
ENCRYPTION_SECRET=change-me-to-a-long-random-secret

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kubeara
DB_PORT=5432
