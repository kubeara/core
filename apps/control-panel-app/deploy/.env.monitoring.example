# Copy to .env.monitoring (never commit secrets).
#
# Grafana Cloud stack portal → your stack → Details / Send logs:
#   GRAFANA_CLOUD_LOKI_URL   — Loki push URL (…/loki/api/v1/push)
#   GRAFANA_CLOUD_LOKI_USER  — numeric instance / user ID
#   GRAFANA_CLOUD_LOKI_API_KEY — access policy token with logs:write
#
# Start with monitoring:
#   docker compose -f docker-compose.control-panel.yml -f docker-compose.monitoring.yml \
#     --env-file .env.control-panel up -d

GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=123456
GRAFANA_CLOUD_LOKI_API_KEY=glc_xxxxxxxx

# Low-cardinality labels for LogQL (do not use per-request IDs here).
KUBEARA_ENV=production
# Host identifier in Loki (control panel hostname, agent public IP, etc.)
KUBEARA_HOST_LABEL=control-panel-1
