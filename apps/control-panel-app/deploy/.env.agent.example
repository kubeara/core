# Copy to .env.agent, then:
#   docker compose -f docker-compose.agent.yml --env-file .env.agent up -d --pull always
#
# ENCRYPTION_SECRET must match the control panel.
# KUBEARA_AGENT_IMAGE is written automatically by the control panel during remote install
# from its own KUBEARA_AGENT_IMAGE setting.

KUBEARA_AGENT_IMAGE=kubeara/agent:prod

AGENT_PORT=3001
# Local / cloud agent: reach the control panel directly.
CONTROL_PANEL_URL=http://host.docker.internal:3000
# Remote self-host (IS_CLOUD_VERSION unset/false): written by onboard as
# CONTROL_PANEL_URL=http://host.docker.internal:<AGENT_SOCKET_TUNNEL_PORT>
ENCRYPTION_SECRET=change-me-to-a-long-random-secret
# Required for agent-to-server binding (auto-set by control panel on remote install).
KUBEARA_SERVER_ID=
# Optional — agent auto-registers with the control panel; set only if IP detection is wrong.
# AGENT_PUBLIC_IP=127.0.0.1
TRAEFIK_ENABLED=false
