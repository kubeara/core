# Copy to .env.agent — ENCRYPTION_SECRET must match the control panel
KUBEARA_AGENT_IMAGE=kubeara/agent:prod
AGENT_PORT=3001
ENCRYPTION_SECRET=encryption-secret
KUBEARA_SERVER_ID=
# Local panel URL (remote tunnel uses host.docker.internal:<AGENT_SOCKET_TUNNEL_PORT>)
CONTROL_PANEL_URL=http://host.docker.internal:9461
