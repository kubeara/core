# Copy to .env.agent, then:
#   docker compose -f docker-compose.agent.yml --env-file .env.agent up -d
#
# ENCRYPTION_SECRET must match the control panel.

KUBEARA_AGENT_IMAGE=kubeara/agent-app:latest

AGENT_PORT=3001
CONTROL_PANEL_URL=http://host.docker.internal:3000
ENCRYPTION_SECRET=change-me-to-a-long-random-secret
AGENT_PUBLIC_IP=127.0.0.1
TRAEFIK_ENABLED=false
