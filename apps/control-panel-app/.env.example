NODE_ENV=development

PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=templates
ENCRYPTION_SECRET=your_encryption_secret_key
# URL remote agents use to reach this API (required for POST /servers/onboard agent install).
# Local agent on same machine: http://localhost:3000
# Remote VPS agent: your public IP or domain, e.g. http://203.0.113.10:3000 (not host.docker.internal)
CONTROL_PANEL_URL=http://localhost:3000
# Docker image installed on remote servers during agent bootstrap (default: kubeara/agent:latest from Docker Hub).
# For local development, build with: docker build -f apps/agent-app/Dockerfile -t kubeara/agent:dev .
# Then set KUBEARA_AGENT_IMAGE=kubeara/agent:dev and KUBEARA_AGENT_SKIP_PULL=true after loading the image on the remote host.
# KUBEARA_AGENT_IMAGE=kubeara/agent:dev
# KUBEARA_AGENT_SKIP_PULL=true
# Optional custom wildcard (defaults to agent sslip.io)
# WILDCARD_DOMAIN=https://apps.example.com
# Route compose deployments via Traefik (port 80; set TRAEFIK_ENABLED=true on agent too)
TRAEFIK_ENABLED=true

JWT_SECRET=vABw7754CcoGqRFSTwLiODXCPZyPadvMv9tpdNzUOdo=
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret

# HTTP-only cookie authentication
ACCESS_TOKEN_COOKIE_NAME=kubeara_access_token
REFRESH_TOKEN_COOKIE_NAME=kubeara_refresh_token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Browser origins allowed to call public marketing APIs (/api/public/*).
# Comma-separated list, e.g. https://kubeara.dev,https://www.kubeara.dev,http://localhost:5173
# Production defaults to kubeara.dev / kubeara.com when unset.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Optional: broader list for console/auth (defaults to PUBLIC_API_ALLOWED_ORIGINS)
CORS_ALLOWED_ORIGINS=https://kubeara.dev,https://www.kubeara.dev,https://app.kubeara.dev

# Grafana Cloud Loki (optional — logs still go to stdout when unset)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=123456
# GRAFANA_CLOUD_LOKI_API_KEY=glc_...
# KUBEARA_ENV=PROD
# KUBEARA_HOST_LABEL=control-panel-local
# LOG_LEVEL=info