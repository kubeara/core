PORT=3000
ENV=development
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kubeara-dev
DB_SSL=false
ENCRYPTION_SECRET=change-me-to-a-long-random-secret
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
ACCESS_TOKEN_COOKIE_NAME=kubeara-access-token
REFRESH_TOKEN_COOKIE_NAME=kubeara-refresh-token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-smtp-login@example.com
SMTP_PASSWORD=your_smtp_password
# Optional: leave empty to disable email delivery without blocking startup.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Kubeara

# Zoho Desk (POST /api/public/support and /api/public/service-requests — creates tickets in Zoho Desk; nothing stored locally)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_organization_id
ZOHO_DEPARTMENT_ID=your_zoho_department_id
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_DESK_BASE_URL=https://desk.zoho.in/api/v1

OTP_EXPIRES_IN=2m
OTP_RESEND_MAX_ATTEMPTS=3
OTP_RESEND_WINDOW_MINUTES=2
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CHECKOUT_PAYMENT_METHODS=card

# Browser origins allowed to call public marketing APIs (/api/public/*).
# Comma-separated list, e.g. https://kubeara.dev,https://www.kubeara.dev,http://localhost:4000
# When unset: production defaults to kubeara.dev / kubeara.com; development allows any localhost origin.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:8080,http://localhost:3000

# Optional: broader list for console/auth (defaults to PUBLIC_API_ALLOWED_ORIGINS)
CORS_ALLOWED_ORIGINS=https://kubeara.dev,https://www.kubeara.dev,https://app.kubeara.dev

# Grafana Cloud Loki (optional — logs still go to stdout when unset)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=123456
# GRAFANA_CLOUD_LOKI_API_KEY=glc_...
# KUBEARA_ENV=PROD
# KUBEARA_HOST_LABEL=control-panel-local
# LOG_LEVEL=info
CONSOLE_URL=http://localhost:4000
MCP_OAUTH_ISSUER=https://9f0f-49-200-183-34.ngrok-free.app
MCP_OAUTH_RESOURCE=https://9f0f-49-200-183-34.ngrok-free.app/api/mcp


# Cron server configuration
IS_CRON_SERVER=true
CRON_URL=http://127.0.0.1:3000
CRON_AUTH_TOKEN=your_cron_auth_token
# Skip individual cron jobs when true (only applies when IS_CRON_SERVER=true)
SKIP_CRON_AGENT_HEALTH_CHECK=false

# Stripe subscription billing
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Comma-separated checkout payment methods.
# Supported values: card, paypal, sepa_debit, us_bank_account, customer_balance
# Note: link is automatic with card and should not be set here.
# USD subscriptions typically support: card, us_bank_account
# Single method:
# STRIPE_CHECKOUT_PAYMENT_METHODS=card
# Multiple methods:
STRIPE_CHECKOUT_PAYMENT_METHODS=card,us_bank_account