PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=templates
ENCRYPTION_SECRET=your_encryption_secret_key
# Optional fallback when no agent is connected yet
DEFAULT_AGENT_PUBLIC_IP=127.0.0.1
# Optional custom wildcard (defaults to agent sslip.io)
# WILDCARD_DOMAIN=https://apps.example.com
# Route compose deployments via Traefik (port 80; set TRAEFIK_ENABLED=true on agent too)
TRAEFIK_ENABLED=true
