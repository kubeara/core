{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "rootDir": "../../",
    "baseUrl": "../../",
    "paths": {
      "@shared/common": ["libs/common/src"],
      "@shared/common/*": ["libs/common/src/*"],
      "@shared/socket-events": ["libs/socket-events/src"],
      "@shared/socket-events/*": ["libs/socket-events/src/*"],
      "@shared/types": ["libs/shared-types/src"],
      "@shared/types/*": ["libs/shared-types/src/*"],
      "@shared/ssh": ["libs/ssh/src"],
      "@shared/ssh/*": ["libs/ssh/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../libs/**/*"
  ],
  "exclude": [
    "../../apps/control-panel-app/**/*",
    "../../libs/**/*.spec.ts",
    "node_modules",
    "dist"
  ]
}