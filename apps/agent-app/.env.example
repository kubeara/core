# Copy to .env before starting:
#   cp apps/agent-app/.env.example apps/agent-app/.env

PORT=3001
CONTROL_PANEL_URL=http://localhost:3000
ENCRYPTION_SECRET=your_encryption_secret_key
# Optional — control panel auto-binds the agent by IP; set only if auto-detect is wrong.
# AGENT_PUBLIC_IP=127.0.0.1
# KUBEARA_SERVER_ID is set automatically on remote install — do not add manually.
# Traefik reverse proxy on ports 80/443 (clean URLs without :5678).
# Deploy defaults use control panel TRAEFIK_ENABLED; the agent must also have this true (or
# receive useTraefik in the deploy payload) and the image must include /app/proxy compose files.
TRAEFIK_ENABLED=true
# TRAEFIK_HTTPS=true
# TRAEFIK_FORCE_HTTPS=true
