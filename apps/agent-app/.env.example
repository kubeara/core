PORT=3001
CONTROL_PANEL_URL=http://localhost:3000
ENCRYPTION_SECRET=your_encryption_secret_key
# Public IP of this machine — used for sslip.io URL generation (Coolify-style)
AGENT_PUBLIC_IP=127.0.0.1
# Traefik reverse proxy on ports 80/443 (clean URLs without :5678)
TRAEFIK_ENABLED=true
# TRAEFIK_HTTPS=true
# TRAEFIK_FORCE_HTTPS=true
