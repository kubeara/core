# Copy to .env before starting:
#   cp apps/agent-app/.env.example apps/agent-app/.env

PORT=3001
# Local / cloud: control panel URL. Remote self-host install writes http://host.docker.internal:<AGENT_SOCKET_TUNNEL_PORT>
CONTROL_PANEL_URL=http://localhost:3000
ENCRYPTION_SECRET=change-me-to-a-long-random-secret
