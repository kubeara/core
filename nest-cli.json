{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "monorepo": true,
  "compilerOptions": {
    "webpack": false
  },
  "projects": {
    "control-panel-app": {
      "type": "application",
      "root": "apps/control-panel-app",
      "entryFile": "apps/control-panel-app/src/main",
      "sourceRoot": "apps/control-panel-app/src",
      "compilerOptions": {
        "deleteOutDir": false,
        "tsConfigPath": "apps/control-panel-app/tsconfig.json",
        "assets": [
          {
            "include": "../deploy/**/*",
            "outDir": "dist/apps/control-panel-app/deploy",
            "watchAssets": true
          },
          {
            "include": "../scripts/**/*",
            "outDir": "dist/apps/control-panel-app/scripts",
            "watchAssets": true
          },
          {
            "include": "modules/email/templates/**/*",
            "outDir": "dist/apps/control-panel-app/src",
            "watchAssets": true
          }
        ]
      }
    },
    "agent-app": {
      "type": "application",
      "root": "apps/agent-app",
      "entryFile": "apps/agent-app/src/main",
      "sourceRoot": "apps/agent-app/src",
      "compilerOptions": {
        "deleteOutDir": false,
        "tsConfigPath": "apps/agent-app/tsconfig.json",
        "assets": [
          {
            "include": "../proxy/**/*",
            "outDir": "dist/apps/agent-app/proxy",
            "watchAssets": true
          }
        ]
      }
    }
  }
}